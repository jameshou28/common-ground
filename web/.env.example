# copy to .env.local, all public and shipped to the browser
NEXT_PUBLIC_API_URL=http://localhost:8000          # fastapi service, render in production
NEXT_PUBLIC_GRID_BASE=http://localhost:8000        # where grids/{tile_id}.bin live, r2 public base in production
NEXT_PUBLIC_CESIUM_ION_TOKEN=                      # domain restricted ion token, blank uses the default
NEXT_PUBLIC_SUPABASE_URL=                          # https://<project-ref>.supabase.co, blank skips the cache read
NEXT_PUBLIC_SUPABASE_ANON_KEY=                     # read only by row level security
NEXT_PUBLIC_MODEL_VERSION=stub-0.1                 # fallback only, the build reads ml/export/example_response.json
NEXT_PUBLIC_LIVE_SCORING=true                      # false = cached results only
