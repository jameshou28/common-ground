# copy to .env. with everything blank the api runs on memory and cache/grids, but /score needs a model
MODEL_URL= # victors model.npz on r2, downloaded into CACHE_DIR at startup
MODEL_PATH= # or a local model.npz, wins over MODEL_URL
ALLOWED_ORIGIN= # the vercel site

SUPABASE_URL= # https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY= # server only, never in the web app

R2_ENDPOINT= # https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE= # https://pub-<hash>.r2.dev
